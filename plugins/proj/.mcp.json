{
  "mcpServers": {
    "proj": {
      "command": "uv",
      "args": [
        "--directory", "${CLAUDE_PLUGIN_ROOT}/server",
        "run", "proj-server"
      ],
      "env": {
        "UV_LINK_MODE": "copy",
        "PROJ_CONFIG": "~/.claude/proj.yaml"
      },
      "timeout": 300
    }
  }
}
