{
  "mcpServers": {
    "jira": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "run",
        "jira-server"
      ],
      "env": {
        "UV_LINK_MODE": "copy",
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_ROOT}/server/.venv",
        "JIRA_CONFIG": "~/.claude/jira.yaml"
      },
      "timeout": 300
    }
  }
}
