{
  "mcpServers": {
    "worktree": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/start.sh",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "worktree-server"
      ],
      "env": {
        "WORKTREE_CONFIG": "~/.claude/worktree.yaml"
      },
      "timeout": 120
    }
  }
}
