{
  "mcpServers": {
    "worktree": {
      "command": "uv",
      "args": [
        "--directory", "${CLAUDE_PLUGIN_ROOT}/server",
        "run", "worktree-server"
      ],
      "env": {
        "UV_LINK_MODE": "copy",
        "WORKTREE_CONFIG": "~/.claude/worktree.yaml"
      },
      "timeout": 300
    }
  }
}
